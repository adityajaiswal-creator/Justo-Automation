{
  "name": "manthan-e2e",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "cases:sync": "node scripts/sync-cases.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:catalog": "node scripts/check-catalog.mjs",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:login": "playwright test specs/login.spec.ts --project=login",
    "test:user": "playwright test specs/user-management.spec.ts --project=qa",
    "test:user:smoke": "playwright test specs/user-management.spec.ts --project=qa --grep USER-NAV-01",
    "test:shift": "playwright test specs/shift-management.spec.ts --project=qa",
    "test:rbac": "playwright test specs/rbac.spec.ts --project=qa",
    "test:ci": "playwright test --project=setup --project=login --project=qa",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.0",
    "eslint": "^9.16.0",
    "@eslint/js": "^9.16.0",
    "eslint-plugin-playwright": "^2.1.0",
    "exceljs": "^4.4.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.18.0"
  }
}
